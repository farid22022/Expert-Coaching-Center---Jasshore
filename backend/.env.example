# Django
DJANGO_SECRET_KEY=change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://127.0.0.1:5173

# bKash credentials are backend-only. Never define VITE_BKASH_* values.
PAYMENT_PROVIDER=bkash
PAYMENT_PROVIDER=bkash
BKASH_MODE=mock
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_TOKEN_URL=
BKASH_CREATE_PAYMENT_URL=
BKASH_EXECUTE_PAYMENT_URL=
BKASH_QUERY_PAYMENT_URL=
BKASH_WEBHOOK_SECRET=
BKASH_CALLBACK_URL=http://127.0.0.1:8000/api/v1/payments/bkash/callback/
BKASH_FRONTEND_RETURN_URL=http://127.0.0.1:5173/student/payments/result
BKASH_CURRENCY=BDT
BKASH_MOCK_ENABLED=true
BKASH_MOCK_ACCOUNT=01700000000
BKASH_MOCK_OTP=123456
BKASH_MOCK_PIN=12121
BKASH_MOCK_DEFAULT_RESULT=manual
BKASH_MOCK_DELAY_MS=700

# PostgreSQL / Neon (when DATABASE_URL is set, MySQL settings below are ignored)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DB_CONN_MAX_AGE=30

# Secure integration settings encryption (generate: python -c "import secrets;print(secrets.token_urlsafe(48))")
APP_CONFIG_ENCRYPTION_KEY=

# Optional ImgBB fallback (the Admin > Integrations key takes priority when enabled)
IMGBB_API_KEY=

# One-time MySQL -> PostgreSQL data migration only; remove after cutover
# LEGACY_MYSQL_NAME=
# LEGACY_MYSQL_USER=
# LEGACY_MYSQL_PASSWORD=
# LEGACY_MYSQL_HOST=localhost
# LEGACY_MYSQL_PORT=3306

